{
  "name": "lapras-card-readme",
  "version": "1.3.0",
  "private": true,
  "description": "Add LAPRAS Card to your GitHub profile",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint src/**/*.ts",
    "package": "ncc build lib/main.js --source-map --license licenses.txt",
    "test": "vitest run",
    "all": "npm run build && npm run format-check && npm run lint && npm run package && npm test && npm run test:typecheck",
    "test:typecheck": "tsc --project tsconfig.test.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actions/typescript-action.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^9.39.5",
    "eslint-plugin-github": "^6.1.2",
    "prettier": "3.9.10",
    "typescript": "~6.0.0",
    "vitest": "^5.0.5"
  },
  "volta": {
    "node": "24.19.0"
  },
  "engines": {
    "node": "24.x"
  }
}
